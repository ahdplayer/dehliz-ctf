# ==================================================
# 🛡️ Dehliz CTF - Konfigürasyon Dosyası (.env)
# ==================================================

# 1. WireGuard Bağlantı Ayarları
# Sunucunuzun yarışmacılara açık olan Dış IP adresi veya Domain'i
WG_HOST=127.0.0.1
WG_PORT=51820

# 2. Yerel Alan Adı (Split-Horizon DNS)
# Soru makinelerine atanacak özel domain uzantısı (Örn: soru-adi.dehliz.local)
DEHLIZ_DOMAIN=dehliz.local

# 3. CTFd Güvenlik Ayarları
# Üretim ortamında bu anahtarı rastgele ve karmaşık bir değerle değiştirin!
SECRET_KEY=dehliz_production_secret_key_change_me_in_prod_2026

# 4. Veritabanı (MariaDB) Bilgileri
MYSQL_ROOT_PASSWORD=dehliz_root_secure_password_2026
MYSQL_USER=ctfd
MYSQL_PASSWORD=dehliz_db_password_2026
MYSQL_DATABASE=ctfd
